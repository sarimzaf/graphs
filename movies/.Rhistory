if (!require("pacman")) install.packages("pacman")
pacman::p_load(DBI, RSQLite, dplyr, ggplot2, stringr, lubridate, readr, tidyr,
ggrepel, ggimage, cowplot, here)
here <- here()
dbfile <- paste0(here, "/movies/movies.db")
con <- dbConnect(RSQLite::SQLite(), dbfile)
dbListTables(con)
directors <- dbReadTable(con, "directors")
movies <- dbReadTable(con, "movies") %>%
rename(movie_id = id)
people <- dbReadTable(con, "people") %>%
rename(person_id = id)
stars <- dbReadTable(con, "stars")
ratings <- dbReadTable(con, "ratings")
people <- left_join(people, directors, by = "person_id", relationship = "many-to-many")
View(people)
View(stars)
View(people)
View(ratings)
View(people)
imdb <- full_join(ratings, movies, by = "movie_id")
#
# people <- left_join(people, stars, by = "person_id")
#
# people <- left_join(people, directors, by = "person_id", relationship = "many-to-many")
View(imdb)
imdb <- imdb %>%
filter(votes >= 1000)
View(imdb)
imdb <- imdb %>%
filter(votes >= 10000)
View(imdb)
link <- "The Ballad of Cable Hogue"
url <- paste0('https://en.wikipedia.org', link)
page <- read_html(URLencode(url))
