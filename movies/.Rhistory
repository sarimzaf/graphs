name <- "The+Ballad+of+Cable+Hogue+movie"
get_budget <- function(name) {
print(name)
## Get player page link
url <- paste0("https://en.wikipedia.org/w/index.php?search=",
name,
"&title=Special%3ASearch&ns0=1")
# if (url.exists(url) == 0) {
#   warning(paste("No url found for", name))
#   return(NA)
# }
page <- read_html(URLencode(url))
links <- page %>%
html_nodes(".mw-search-result-ns-0:nth-child(1) a") %>%
html_attr('href')
movie_link <- links[1]
## Get infobox
url <- paste0('https://en.wikipedia.org', movie_link)
if (url.exists(url) == 0) {
warning(paste("No url found for", player_link))
return(NA)
}
page <- read_html(URLencode(url))
infobox <- page %>%
html_nodes(".infobox")
if (length(infobox) == 0) {
warning(paste("No infobox found for", name))
return(NA) # Return NA if still no infobox is found
}
# Extract the table from the infobox.
infobox_tables <- infobox %>%
html_table()
# Check if any tables were extracted
if (length(infobox_tables) == 0) {
warning(paste("No table found within infobox for", name))
return(NA)
}
infobox_df <- as.data.frame(infobox_tables)
# Assuming the first table in the infobox_tables list is the one we want
x <- c(infobox_tables[[1]][1], infobox_tables[[1]][2])
infobox_df <- as.data.frame(setNames(x, c("Category", "Info")))
if (count(infobox_df) == 0) {
return(NA)
}
budget <- infobox_df %>%
filter(Category == "Budget") %>%
select(Info)
return(budget)
}
get_budget("The+Ballad+of+Cable+Hogue+movie")
